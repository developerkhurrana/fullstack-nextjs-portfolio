# Cloudinary configuration
# Set these in your deployment environment (e.g. Vercel Project Settings > Environment Variables).
# Do NOT commit real values — copy this file to .env.local for local development.

# Public: appears in delivered image URLs. Safe to expose to the browser.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Server-only: used by app/api/cloudinary route. NEVER expose these to the client.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
